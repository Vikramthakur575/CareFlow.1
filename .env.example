# CareFlow Clinical Appointment System Configuration
PORT=3000
NODE_ENV="development"
JWT_SECRET="replace-with-a-random-secure-32-byte-hex-secret"

# Optional external PostgreSQL connection URL (if connecting to standalone PostgreSQL)
# Defaults to embedded WebAssembly PostgreSQL ACID engine (.careflow_data) if unset
DATABASE_URL="postgresql://user:password@localhost:5432/careflow"

# GEMINI_API_KEY: Injected by AI Studio if AI features are invoked
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
